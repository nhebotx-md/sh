const { DOMImplementation, XMLSerializer } = require('xmldom');
const fs = require('fs');
const path = require('path');
const cp = require('child_process');
const { JSDOM } = require('jsdom'); // Pastikan ini diimpor

// Path ke folder sumber daya
const src = path.join(__dirname, '..', 'src');

// Template SVG dasar
const _svg = fs.readFileSync(path.join(src, 'welcome.svg'), 'utf-8');

/**
 * Set atribut gambar (xlink:href)
 * @param {Element} img - Elemen gambar
 * @param {string} value - Nilai atribut
 */
const imageSetter = (img, value) => img.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', value);

/**
 * Set teks pada elemen
 * @param {Element} el - Elemen teks
 * @param {string} value - Nilai teks
 */
const textSetter = (el, value) => el.textContent = value;

// Parse template SVG
let { document: svg } = new JSDOM(_svg).window;

/**
 * Generate SVG Welcome
 * @param {object} param0
 * @param {string} param0.pp - Path ke profile picture
 * @param {string} param0.name - Nama pengguna
 * @param {string} param0.text - Teks welcome/goodbye
 * @param {string} param0.title - Judul grup
 * @param {string} param0.background - Path ke background
 * @returns {Promise<string>} - SVG yang telah di-generate
 */
const genSVG = async ({
    pp = path.join(src, 'avatar_contact.png'),
    title = '',
    name = '',
    text = '',
    background = ''
} = {}) => {
    let el = {
        pp: ['#_pp_image', imageSetter, pp],
        text: ['#_welcome_text', textSetter, text],
        title: ['#_group_text', textSetter, title],
        name: ['#_name_text', textSetter, name],
        bg: ['#_bg_image', imageSetter, background],
    };

    for (let [selector, set, value] of Object.values(el)) {
        let element = svg.querySelector(selector);
        if (!element) {
            console.error(`❌ Elemen tidak ditemukan untuk selector: ${selector}`);
            continue;
        }
        set(element, value);
    }

    return svg.body.innerHTML;
};

/**
 * Render SVG ke format gambar
 * @param {string} svg - Konten SVG
 * @param {string} format - Format output (png, jpg, dll.)
 * @returns {Promise<Buffer>}
 */
const toImg = (svg, format = 'png') => new Promise((resolve, reject) => {
    if (!svg) return resolve(Buffer.alloc(0));
    let bufs = [];
    let im = cp.spawn('magick', ['convert', 'svg:-', `${format}:-`]);
    im.on('error', e => reject(e));
    im.stdout.on('data', chunk => bufs.push(chunk));
    im.stdin.write(Buffer.from(svg));
    im.stdin.end();
    im.on('close', code => {
        if (code !== 0) reject(code);
        resolve(Buffer.concat(bufs));
    });
});

/**
 * Konversi buffer ke base64
 * @param {Buffer} buffer
 * @param {string} mime
 * @returns {string}
 */
const toBase64 = (buffer, mime) => `data:${mime};base64,${buffer.toString('base64')}`;

/**
 * Render Welcome Image
 * @param {object} param0
 * @param {string} param0.pp - Path ke profile picture
 * @param {string} param0.name - Nama pengguna
 * @param {string} param0.text - Teks welcome/goodbye
 * @param {string} param0.title - Judul grup
 * @param {string} param0.background - Path ke background
 * @param {string} format - Format output (png, jpg, dll.)
 * @returns {Promise<Buffer>}
 */
const render = async ({
    pp = toBase64(fs.readFileSync(path.join(src, 'avatar_contact.png')), 'image/png'),
    name = '',
    title = '',
    text = '',
    background = toBase64(fs.readFileSync(path.join(src, 'Aesthetic', 'Aesthetic_000.jpeg')), 'image/jpeg'),
} = {}, format = 'jpg') => {
    let svg = await genSVG({
        pp, name, text, background, title
    });
    return await toImg(svg, format);
};

// Ekspor fungsi render jika digunakan sebagai modul
if (require.main === module) {
    render({
        pp: path.join(src, 'avatar_contact.png'), // Path ke profile picture
        name: 'John Doe',
        text: 'Selamat datang di grup!',
        title: 'Grup Testing',
        background: path.join(src, 'Aesthetic', 'Aesthetic_000.jpeg'), // Path ke background
    }, 'jpg').then(result => {
        fs.writeFileSync(path.join(src, 'output_welcome.jpg'), result); // Simpan hasil render
        console.log('✅ Gambar welcome berhasil di-render!');
    }).catch(err => {
        console.error('❌ Error:', err);
    });
} else {
    module.exports = render;
}